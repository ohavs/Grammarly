{
  "manifest_version": 3,
  "name": "WriteRight",
  "version": "0.0.1",
  "description": "Offline grammar, spelling and clarity checker for any text field on the web.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "WriteRight"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["dict/index.aff", "dict/index.dic"],
      "matches": ["<all_urls>"]
    }
  ]
}
