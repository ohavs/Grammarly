{
  "name": "writeright",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "web",
    "desktop",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @writeright/desktop",
    "dev:web": "npm run dev -w @writeright/web",
    "build": "npm run build -w @writeright/desktop",
    "dist": "npm run dist -w @writeright/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
