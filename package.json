{
  "name": "writeright",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "web",
    "desktop",
    "shared",
    "extension"
  ],
  "scripts": {
    "dev": "npm run dev -w @writeright/desktop",
    "dev:web": "npm run dev -w @writeright/web",
    "dev:extension": "npm run dev -w @writeright/extension",
    "build": "npm run build -w @writeright/desktop",
    "build:extension": "npm run build -w @writeright/extension",
    "dist": "npm run dist -w @writeright/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
